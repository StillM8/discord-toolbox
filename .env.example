# Required Discord application credentials
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
OWNER_DISCORD_ID=

LOG_LEVEL=INFO

# Runtime persistence and local assets
# Docker Compose overrides these paths with mounted /data locations.
DATABASE_URL=sqlite+aiosqlite:///./data/toolbox.db
ASSET_DIRECTORY=./data/assets
DEFAULT_TIMEZONE=Asia/Karachi

# Local SearXNG service
SEARXNG_URL=http://searxng:8080

# Codex SDK text provider. Authenticate once and persist this directory.
CODEX_COMMAND=codex
CODEX_HOME=/data/codex
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_SECONDS=90
# Image editing/generation can take longer than text turns.
CODEX_IMAGE_TIMEOUT_SECONDS=300
# Keep Codex image edits/generation responsive; semantic edit quality is still
# provided by the image-generation tool itself.
CODEX_IMAGE_EFFORT=low
MAX_CODEX_CONCURRENCY=2

# Optional OpenAI API integrations. The SDK is an optional install and these
# features remain disabled unless explicitly enabled.
OPENAI_API_KEY=
OPENAI_FALLBACK_ENABLED=false
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ENABLE_PAID_IMAGE_FALLBACK=false
ENABLE_OPENAI_TRANSCRIPTION=false

# Optional integrations; missing credentials disable only that feature.
ENABLE_GIPHY=false
GIPHY_API_KEY=
ENABLE_TMDB=false
TMDB_API_TOKEN=
ENABLE_YOUTUBE_API=false
YOUTUBE_API_KEY=
ENABLE_LOCAL_BACKGROUND_REMOVAL=false
ENABLE_LOCAL_TRANSCRIPTION=false
